:root {
  --text: #f5f5f7;
  --muted: rgba(245, 245, 247, .62);
  --accent: #ff5a16;
  --card-bg: rgba(18, 18, 20, .74);
  --card-line: rgba(255, 255, 255, .14);
  --card-line-active: rgba(255, 255, 255, .48);
  --shadow: 0 28px 80px rgba(0, 0, 0, .34);
}

* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; background: transparent !important; }
body { color: var(--text); font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; }
button { font: inherit; }

.reviews {
  position: relative;
  overflow: hidden;
  padding: 12px 0 32px;
  background: transparent;
}

.reviews__inner {
  width: min(1480px, calc(100% - 28px));
  margin: 0 auto;
}

.reviews__title {
  margin: 0 0 48px;
  text-align: center;
  font-size: clamp(27px, 3.2vw, 52px);
  line-height: 1;
  font-weight: 850;
  font-style: italic;
  letter-spacing: -.035em;
  text-transform: uppercase;
  text-wrap: balance;
}

.reviews__title span { color: var(--accent); }

.reviews__slider {
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr) 58px;
  align-items: center;
  gap: 14px;
}

.reviews__viewport {
  overflow: hidden;
  padding: 44px 0 50px;
  touch-action: pan-y;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
}

.reviews__track {
  display: flex;
  align-items: center;
  gap: 22px;
  will-change: transform;
  transition: transform .72s cubic-bezier(.2,.75,.25,1);
}

.review-card {
  position: relative;
  flex: 0 0 min(480px, 42vw);
  min-height: 345px;
  padding: 34px;
  display: grid;
  grid-template-columns: 112px 1fr;
  grid-template-rows: auto 1fr auto;
  column-gap: 28px;
  row-gap: 22px;
  border: 1px solid var(--card-line);
  border-radius: 30px;
  background: linear-gradient(145deg, rgba(35,35,38,.82), var(--card-bg));
  box-shadow: 0 18px 50px rgba(0,0,0,.18), inset 0 1px rgba(255,255,255,.055);
  backdrop-filter: blur(22px) saturate(120%);
  -webkit-backdrop-filter: blur(22px) saturate(120%);
  opacity: .46;
  transform: scale(.82);
  filter: saturate(.72);
  transition: transform .72s cubic-bezier(.2,.75,.25,1), opacity .55s ease, filter .55s ease, border-color .55s ease, box-shadow .55s ease;
  cursor: pointer;
  overflow: hidden;
}

.review-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(135deg, rgba(255,255,255,.08), transparent 34%, transparent 72%, rgba(255,90,22,.035));
}

.review-card.is-near {
  opacity: .72;
  transform: scale(.91);
  filter: saturate(.9);
}

.review-card.is-active {
  z-index: 3;
  opacity: 1;
  transform: scale(1);
  filter: none;
  border-color: var(--card-line-active);
  box-shadow: var(--shadow), inset 0 1px rgba(255,255,255,.11), 0 0 0 1px rgba(255,255,255,.04);
}

.review-card__avatar {
  width: 112px;
  height: 112px;
  border-radius: 50%;
  object-fit: cover;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.16);
  align-self: start;
}

.review-card__avatar--placeholder {
  display: grid;
  place-items: center;
  font-size: 40px;
  font-weight: 750;
  color: #fff;
  background: linear-gradient(145deg, rgba(255,90,22,.42), rgba(255,255,255,.08));
}

.review-card__head { align-self: center; min-width: 0; }
.review-card__name {
  margin: 0 0 15px;
  font-size: clamp(22px, 2vw, 30px);
  line-height: 1.1;
  font-weight: 720;
  letter-spacing: -.025em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.review-card__stars {
  color: var(--accent);
  font-size: clamp(23px, 2.1vw, 32px);
  line-height: 1;
  letter-spacing: 3px;
  white-space: nowrap;
  text-shadow: 0 0 22px rgba(255,90,22,.16);
}

.review-card__text {
  grid-column: 1 / -1;
  margin: 0;
  color: rgba(245,245,247,.9);
  font-size: clamp(17px, 1.55vw, 22px);
  line-height: 1.58;
  letter-spacing: -.01em;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.review-card__date {
  grid-column: 1 / -1;
  color: var(--muted);
  font-size: 14px;
  line-height: 1;
  align-self: end;
}

.reviews__arrow {
  width: 56px;
  height: 56px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: 2px solid var(--accent);
  background: rgba(0,0,0,.12);
  color: var(--accent);
  cursor: pointer;
  transition: transform .22s ease, background .22s ease, color .22s ease, opacity .22s ease;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.reviews__arrow span { font-size: 48px; line-height: .7; transform: translateY(-2px); }
.reviews__arrow:hover { background: var(--accent); color: #fff; transform: scale(1.06); }
.reviews__arrow:active { transform: scale(.96); }

.reviews__dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 13px;
  min-height: 18px;
}

.reviews__dot {
  width: 9px;
  height: 9px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255,255,255,.34);
  cursor: pointer;
  transition: width .28s ease, border-radius .28s ease, background .28s ease, transform .28s ease;
}

.reviews__dot.is-active { width: 28px; border-radius: 20px; background: var(--accent); }
.reviews__status { min-height: 18px; margin: 16px 0 0; text-align: center; color: var(--muted); font-size: 13px; }

@media (max-width: 900px) {
  .reviews { padding-top: 10px; }
  .reviews__title { margin-bottom: 20px; }
  .reviews__slider { grid-template-columns: 44px minmax(0,1fr) 44px; gap: 4px; }
  .reviews__viewport { padding: 34px 0 42px; -webkit-mask-image: none; mask-image: none; }
  .reviews__arrow { width: 42px; height: 42px; }
  .reviews__arrow span { font-size: 38px; }
  .review-card { flex-basis: min(430px, 72vw); min-height: 330px; padding: 27px; grid-template-columns: 92px 1fr; column-gap: 20px; border-radius: 26px; }
  .review-card__avatar { width: 92px; height: 92px; }
}

@media (max-width: 560px) {
  .reviews { padding: 8px 0 24px; }
  .reviews__inner { width: 100%; }
  .reviews__title { padding: 0 18px; margin-bottom: 10px; font-size: clamp(24px, 8vw, 34px); }
  .reviews__slider { grid-template-columns: 40px minmax(0,1fr) 40px; gap: 0; }
  .reviews__viewport { padding: 28px 0 34px; }
  .reviews__arrow { width: 36px; height: 36px; justify-self: center; z-index: 5; }
  .reviews__arrow span { font-size: 33px; }
  .review-card { flex-basis: calc(100vw - 98px); min-height: 315px; padding: 23px; grid-template-columns: 76px 1fr; row-gap: 18px; border-radius: 23px; }
  .review-card__avatar { width: 76px; height: 76px; }
  .review-card__name { font-size: 20px; margin-bottom: 10px; }
  .review-card__stars { font-size: 21px; letter-spacing: 1px; }
  .review-card__text { font-size: 16px; line-height: 1.5; }
}

@media (prefers-reduced-motion: reduce) {
  .reviews__track, .review-card, .reviews__dot, .reviews__arrow { transition: none !important; }
}
